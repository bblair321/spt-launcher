<Page x:Class="SptLauncherWpf.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified">

    <Page.Resources>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4B5563"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,4,0,16" MaxWidth="720" HorizontalAlignment="Stretch">

            <Border Style="{StaticResource ModernCardStyle}" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Updates"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryColor}"
                               Margin="0,0,0,14"/>

                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <CheckBox Name="AutoUpdateCheckBox"
                                  DockPanel.Dock="Left"
                                  VerticalAlignment="Top"
                                  Margin="0,2,12,0"
                                  Padding="0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Grid>
                                                    <Border x:Name="CheckBoxBorder" Width="20" Height="20"
                                                            CornerRadius="4" BorderBrush="{DynamicResource BorderColor}"
                                                            BorderThickness="2" Background="{DynamicResource CardBackgroundColor}"/>
                                                    <Path x:Name="CheckMark" Data="M 2 6 L 6 10 L 14 2"
                                                          Stroke="White" StrokeThickness="2"
                                                          Visibility="Collapsed" Margin="3,3,3,3"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                                        <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                        <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <StackPanel>
                            <TextBlock Text="Check for launcher updates automatically"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       FontSize="14"/>
                            <TextBlock Text="Notify when a newer SPT Launcher release is available."
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <Button Name="CheckForUpdatesButton"
                            Content="Check for updates now"
                            Style="{StaticResource QuietButtonStyle}"
                            Click="CheckForUpdatesButton_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ModernCardStyle}" Padding="20" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Preferences"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryColor}"
                               Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Name="SaveSettingsButton"
                                Content="Save"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="{DynamicResource PrimaryColor}"
                                Padding="18,10"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Click="SaveSettingsButton_Click"
                                Margin="0,0,8,0"/>
                        <Button Name="CancelSettingsButton"
                                Content="Reset changes"
                                Style="{StaticResource QuietButtonStyle}"
                                Click="CancelSettingsButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
