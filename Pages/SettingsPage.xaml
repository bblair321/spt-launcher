<Page x:Class="SptLauncherWpf.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0" >
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Configure your SPT Launcher preferences" 
                           FontSize="16" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Theme Test Card -->
            <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                    CornerRadius="12" Padding="32" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Theme Test" FontSize="20" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,16"/>
                    <TextBlock Text="This text should change color when you switch themes:" 
                               Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,8"/>
                    <TextBlock Text="Primary Text" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8"/>
                    <TextBlock Text="Secondary Text" FontSize="14" 
                               Foreground="{DynamicResource TextSecondaryColor}" Margin="0,0,0,8"/>
                    <Border Background="{DynamicResource PrimaryColor}" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                        <TextBlock Text="Primary Color Background" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- General Settings -->
            <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                    CornerRadius="12" Padding="32" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Border Background="{DynamicResource PrimaryColor}" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <TextBlock Text="⚙️" FontSize="16" Foreground="White"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="General Settings" FontSize="20" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryColor}"/>
                            <TextBlock Text="Configure basic application behavior" FontSize="14" 
                                       Foreground="{DynamicResource TextSecondaryColor}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <!-- Auto-start with Windows -->
                        <Border Background="{DynamicResource SurfaceColor}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="AutoStartCheckBox" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Grid>
                                                            <Border x:Name="CheckBoxBorder" Width="20" Height="20" 
                                                                    CornerRadius="4" BorderBrush="{DynamicResource BorderColor}" 
                                                                    BorderThickness="2" Background="{DynamicResource CardBackgroundColor}"/>
                                                            <Path x:Name="CheckMark" Data="M 3 9 L 7 13 L 17 3" 
                                                                  Stroke="#FFFFFF" StrokeThickness="2" 
                                                                  Visibility="Collapsed" Margin="2"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryColor}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryColor}" FontSize="16"/>
                                    <TextBlock Text="Automatically launch SPT Launcher when Windows starts" 
                                               Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Minimize to tray -->
                        <Border Background="{DynamicResource SurfaceColor}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="MinimizeToTrayCheckBox" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Grid>
                                                            <Border x:Name="CheckBoxBorder" Width="20" Height="20" 
                                                                    CornerRadius="4" BorderBrush="{DynamicResource BorderColor}" 
                                                                    BorderThickness="2" Background="{DynamicResource CardBackgroundColor}"/>
                                                            <Path x:Name="CheckMark" Data="M 3 9 L 7 13 L 17 3" 
                                                                  Stroke="#FFFFFF" StrokeThickness="2" 
                                                                  Visibility="Collapsed" Margin="2"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryColor}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <StackPanel>
                                    <TextBlock Text="Minimize to System Tray" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryColor}" FontSize="16"/>
                                    <TextBlock Text="Hide window to system tray instead of taskbar when minimized" 
                                               Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Auto-update -->
                        <Border Background="{DynamicResource SurfaceColor}" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Name="AutoUpdateCheckBox" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Grid>
                                                            <Border x:Name="CheckBoxBorder" Width="20" Height="20" 
                                                                    CornerRadius="4" BorderBrush="{DynamicResource BorderColor}" 
                                                                    BorderThickness="2" Background="{DynamicResource CardBackgroundColor}"/>
                                                            <Path x:Name="CheckMark" Data="M 3 9 L 7 13 L 17 3" 
                                                                  Stroke="#FFFFFF" StrokeThickness="2" 
                                                                  Visibility="Collapsed" Margin="2"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource PrimaryColor}"/>
                                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryColor}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <StackPanel>
                                    <TextBlock Text="Check for Updates Automatically" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextPrimaryColor}" FontSize="16"/>
                                    <TextBlock Text="Automatically check and notify about new versions" 
                                               Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Theme -->
                        <Border Background="{DynamicResource SurfaceColor}" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Application Theme" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryColor}" FontSize="16" Margin="0,0,0,8"/>
                                <TextBlock Text="Choose your preferred color scheme" 
                                           Foreground="{DynamicResource TextSecondaryColor}" FontSize="14" Margin="0,0,0,12"/>
                                <ComboBox Name="ThemeComboBox" FontSize="14" Height="40"
                                          Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                          Background="{DynamicResource CardBackgroundColor}" SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="🌞 Light Theme" Tag="light"/>
                                    <ComboBoxItem Content="🌙 Dark Theme" Tag="dark" IsSelected="True"/>
                                    <ComboBoxItem Content="🖥️ System Theme" Tag="system"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>




            <!-- Action Buttons -->
            <Border Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                    CornerRadius="12" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#10B981" CornerRadius="6" Padding="6" Margin="0,0,10,0">
                            <TextBlock Text="💾" FontSize="14" Foreground="White"/>
                        </Border>
                        <TextBlock Text="Actions" FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Name="SaveSettingsButton" 
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="{DynamicResource PrimaryColor}"
                                Padding="32,16" FontSize="16" FontWeight="SemiBold"
                                Click="SaveSettingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Save Settings"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="CancelSettingsButton" 
                                Style="{StaticResource ModernButtonStyle}" 
                                Background="{DynamicResource TextSecondaryColor}"
                                Padding="32,16" FontSize="16" FontWeight="SemiBold"
                                Margin="16,0,0,0" Click="CancelSettingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↩️" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Reset Changes"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
