<Page x:Class="SptLauncherWpf.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0" >
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" 
                           Foreground="#374151" HorizontalAlignment="Center"/>
                <TextBlock Text="Configure your SPT Launcher preferences" 
                           FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- General Settings -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="#2563EB" Margin="0,0,8,0"/>
                        <TextBlock Text="General Settings" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel >
                        <!-- Auto-start with Windows -->
                        <CheckBox Name="AutoStartCheckBox" Content="Start with Windows" 
                                  FontWeight="Medium" Foreground="#111827"/>

                        <!-- Minimize to tray -->
                        <CheckBox Name="MinimizeToTrayCheckBox" Content="Minimize to system tray" 
                                  FontWeight="Medium" Foreground="#111827"/>

                        <!-- Auto-update -->
                        <CheckBox Name="AutoUpdateCheckBox" Content="Check for updates automatically" 
                                  FontWeight="Medium" Foreground="#111827"/>

                        <!-- Theme -->
                        <StackPanel>
                            <TextBlock Text="Theme" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <ComboBox Name="ThemeComboBox" FontSize="14"
                                      Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1">
                                <ComboBoxItem Content="Light" Tag="light"/>
                                <ComboBoxItem Content="Dark" Tag="dark" IsSelected="True"/>
                                <ComboBoxItem Content="System" Tag="system"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Launcher Settings -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,8,0"/>
                        <TextBlock Text="Launcher Settings" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel >
                        <!-- Default launcher path -->
                        <StackPanel>
                            <TextBlock Text="Default Launcher Path" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0" Name="DefaultLauncherPathTextBox" 
                                         Text="D:\SPT\SPT.Launcher.exe" FontSize="14"
                                         Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                
                                <Button Grid.Column="1" Name="BrowseDefaultPathButton" Content="Browse" 
                                        Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                        Padding="12,8" Margin="8,0,0,0" Click="BrowseDefaultPathButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Auto-save logs -->
                        <CheckBox Name="AutoSaveLogsCheckBox" Content="Automatically save server logs" 
                                  FontWeight="Medium" Foreground="#111827"/>

                        <!-- Log retention -->
                        <StackPanel>
                            <TextBlock Text="Log Retention (days)" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <TextBox Name="LogRetentionTextBox" Text="30" FontSize="14"
                                     Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Server Settings -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,8,0"/>
                        <TextBlock Text="Server Settings" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel >
                        <!-- Default server port -->
                        <StackPanel>
                            <TextBlock Text="Default Server Port" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <TextBox Name="DefaultPortTextBox" Text="6969" FontSize="14"
                                     Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Auto-start servers -->
                        <CheckBox Name="AutoStartServersCheckBox" Content="Auto-start configured servers on launch" 
                                  FontWeight="Medium" Foreground="#111827"/>

                        <!-- Server timeout -->
                        <StackPanel>
                            <TextBlock Text="Server Timeout (seconds)" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <TextBox Name="ServerTimeoutTextBox" Text="30" FontSize="14"
                                     Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center">
                <Button Name="SaveSettingsButton" Content="Save Settings" 
                        Style="{StaticResource ModernButtonStyle}" Background="#2563EB"
                        Padding="24,12" FontSize="16" Click="SaveSettingsButton_Click"/>
                <Button Name="CancelSettingsButton" Content="Cancel" 
                        Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                        Padding="24,12" FontSize="16" Click="CancelSettingsButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
