<Page x:Class="SptLauncherWpf.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:SptLauncherWpf.Controls"
      Title="Servers"
      Loaded="ServersPage_Loaded"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified">

    <Page.Resources>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4B5563"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,4,0,16" MaxWidth="980" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Server form -->
                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}"
                        Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Name="FormTitle" Text="Add server"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Server name" FontWeight="Medium" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,6"/>
                        <TextBox Name="ServerNameTextBox" Text="My SPT Server"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Server type" FontWeight="Medium" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8"/>
                        <RadioButton Name="LocalServerRadio" Content="Local server"
                                     IsChecked="True" GroupName="ServerType"
                                     Checked="ServerType_Changed" Margin="0,0,0,12"
                                     FontSize="13" Foreground="{DynamicResource TextPrimaryColor}" Padding="0,4">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                                                        <Ellipse x:Name="OuterEllipse"
                                                                 Stroke="{DynamicResource BorderColor}" StrokeThickness="2"
                                                                 Fill="{DynamicResource CardBackgroundColor}"/>
                                                        <Ellipse x:Name="InnerEllipse" Width="10" Height="10"
                                                                 Fill="{DynamicResource PrimaryColor}"
                                                                 Visibility="Collapsed"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="InnerEllipse" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="OuterEllipse" Property="Stroke" Value="{DynamicResource PrimaryColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>

                        <StackPanel Name="LocalServerPanel" Margin="0,0,0,12">
                            <TextBlock Text="Server executable" FontWeight="Medium" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="ServerPathTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                                <Button Grid.Column="1" Name="BrowseServerButton" Content="Browse"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="8,0,0,0" Click="BrowseServerButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Port" FontWeight="Medium" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,6"/>
                        <TextBox Name="PortTextBox" Text="6969"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Description" FontWeight="Medium" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,6"/>
                        <TextBox Name="DescriptionTextBox"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="56"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12"/>

                        <CheckBox Name="AutoStartCheckBox" Content="Auto-start with launcher"
                                  FontWeight="Medium" Foreground="{DynamicResource TextPrimaryColor}"
                                  FontSize="13" Padding="0,6" Margin="0,0,0,16">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="border" Width="20" Height="20"
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="2"
                                                            Background="{DynamicResource CardBackgroundColor}" CornerRadius="4"
                                                            VerticalAlignment="Center"/>
                                                    <Path x:Name="checkMark" Data="M 2 6 L 6 10 L 14 2"
                                                          Stroke="{DynamicResource PrimaryColor}" StrokeThickness="2"
                                                          Visibility="Collapsed" Margin="3,3,3,3"
                                                          VerticalAlignment="Center"/>
                                                    <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                                                      VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Name="SaveServerButton" Content="Add server"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="{DynamicResource PrimaryColor}"
                                    Padding="16,10" FontSize="13"
                                    Click="SaveServerButton_Click" Margin="0,0,8,0"/>
                            <Button Name="CancelEditButton" Content="Cancel"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Visibility="Collapsed" Click="CancelEditButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Server list + console -->
                <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}"
                        Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Configured servers"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   Margin="0,0,0,12"/>

                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden"
                                      PreviewMouseWheel="ServersListScrollViewer_PreviewMouseWheel">
                            <StackPanel Name="ServersListPanel"/>
                        </ScrollViewer>

                        <DockPanel Margin="0,16,0,8" LastChildFill="False">
                            <TextBlock Text="Console"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       VerticalAlignment="Center"/>
                            <Button Name="ClearLogButton" Content="Clear"
                                    Style="{StaticResource QuietButtonStyle}"
                                    DockPanel.Dock="Right"
                                    Click="ClearLogButton_Click"/>
                        </DockPanel>

                        <Border Background="{DynamicResource HoverColor}"
                                CornerRadius="8"
                                Padding="10"
                                Height="280">
                            <Grid>
                                <TextBlock Name="NoServerRunningText"
                                           Text="No server is running. Launch one to see console output here."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <Border Name="ConsoleContainer"
                                        Background="#111827"
                                        CornerRadius="6"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
