<Page x:Class="SptLauncherWpf.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:SptLauncherWpf.Controls"
      Title="Servers"
      Loaded="ServersPage_Loaded"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified">
    
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,16,0,0" >
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="Server Management" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Configure and manage your SPT-AKI servers" 
                           FontSize="16" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Server Form -->
                <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" 
                        Padding="24" Margin="0,0,12,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Ellipse Width="16" Height="16" Fill="#2563EB" Margin="0,0,8,0"
                                     RenderOptions.EdgeMode="Unspecified"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     UseLayoutRounding="True"
                                     SnapsToDevicePixels="True"/>
                            <TextBlock Name="FormTitle" Text="Add New Server" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel >
                            <!-- Server Name -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Server Name" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8"/>
                                <TextBox Name="ServerNameTextBox" Text="My SPT Server" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Server Type -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Server Type" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <RadioButton Name="LocalServerRadio" Content="Local Server" 
                                                IsChecked="True" GroupName="ServerType" 
                                                Checked="ServerType_Changed" Margin="0,0,32,0"
                                                FontSize="14" Foreground="{DynamicResource TextPrimaryColor}" Padding="0,8">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Grid>
                                                                <Ellipse x:Name="OuterEllipse" Width="20" Height="20" 
                                                                         Stroke="#D1D5DB" StrokeThickness="2" 
                                                                         Fill="White" Margin="-76,0,8,0" VerticalAlignment="Center"
                                                                         RenderOptions.EdgeMode="Unspecified"
                                                                         RenderOptions.BitmapScalingMode="HighQuality"
                                                                         UseLayoutRounding="True"
                                                                         SnapsToDevicePixels="True"/>
                                                                <Ellipse x:Name="InnerEllipse" Width="10" Height="10" 
                                                                         Fill="#2563EB" Margin="-71,5,13,5" 
                                                                         Visibility="Collapsed" VerticalAlignment="Center"
                                                                         RenderOptions.EdgeMode="Unspecified"
                                                                         RenderOptions.BitmapScalingMode="HighQuality"
                                                                         UseLayoutRounding="True"
                                                                         SnapsToDevicePixels="True"/>
                                                                <ContentPresenter Margin="32,0,0,0" 
                                                                                  VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="InnerEllipse" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="OuterEllipse" Property="Stroke" Value="#2563EB"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="OuterEllipse" Property="Stroke" Value="#9CA3AF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Local Server Path -->
                            <StackPanel Name="LocalServerPanel" Margin="0,0,0,16">
                                <TextBlock Text="Server Executable" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0" Name="ServerPathTextBox" 
                                             Text="D:\SPT\Aki.Server.exe" 
                                             Style="{StaticResource ModernTextBoxStyle}"/>
                                    
                                    <Button Grid.Column="1" Name="BrowseServerButton" Content="Browse" 
                                            Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                            Padding="16,10" Margin="8,0,0,0" Click="BrowseServerButton_Click"
                                            FontSize="14" FontWeight="Medium"/>
                                </Grid>
                            </StackPanel>


                            <!-- Port -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Port" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8"/>
                                <TextBox Name="PortTextBox" Text="6969" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Description -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Description" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8"/>
                                <TextBox Name="DescriptionTextBox" Text="" 
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Auto-start -->
                            <StackPanel Margin="0,0,0,24">
                                <CheckBox Name="AutoStartCheckBox" Content="Auto-start with launcher" 
                                          FontWeight="Medium" Foreground="{DynamicResource TextPrimaryColor}" FontSize="14" Padding="0,8">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="CheckBox">
                                                        <Grid>
                                                            <Border x:Name="border" Width="20" Height="20" 
                                                                    BorderBrush="#D1D5DB" BorderThickness="2" 
                                                                    Background="White" CornerRadius="4" Margin="0,0,12,0" 
                                                                    VerticalAlignment="Center"/>
                                                            <Path x:Name="checkMark" Data="M 2 6 L 6 10 L 14 2" 
                                                                  Stroke="#2563EB" StrokeThickness="2" 
                                                                  Visibility="Collapsed" Margin="3,3,15,3" 
                                                                  VerticalAlignment="Center"/>
                                                            <ContentPresenter Margin="32,0,0,0" 
                                                                              VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="border" Property="BorderBrush" Value="#9CA3AF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Button Name="SaveServerButton" Content="Add Server" 
                                        Style="{StaticResource ModernButtonStyle}" Background="#2563EB"
                                        Click="SaveServerButton_Click" Margin="0,0,12,0"/>
                                <Button Name="CancelEditButton" Content="Cancel" 
                                        Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                        Visibility="Collapsed" Click="CancelEditButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Server List -->
                <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" 
                        Padding="24" Margin="12,0,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,8,0"
                                     RenderOptions.EdgeMode="Unspecified"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     UseLayoutRounding="True"
                                     SnapsToDevicePixels="True"/>
                            <TextBlock Text="Configured Servers" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                            <StackPanel Name="ServersListPanel" >
                                <!-- Servers will be added here dynamically -->
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Server Console Section -->
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="16" Height="16" Fill="#10B981" Margin="0,0,8,0"
                                         RenderOptions.EdgeMode="Unspecified"
                                         RenderOptions.BitmapScalingMode="HighQuality"
                                         UseLayoutRounding="True"
                                         SnapsToDevicePixels="True"/>
                                <TextBlock Text="Server Console" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                                <Button Name="ClearLogButton" Content="Clear Console" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Background="#6B7280" Padding="8,4" Margin="16,0,0,0"
                                        FontSize="12" Click="ClearLogButton_Click"/>
                            </StackPanel>

                            <Border Style="{StaticResource ModernCardStyle}" 
                                    Padding="12" Height="300">
                                <Grid>
                                    <TextBlock Name="NoServerRunningText" 
                                               Text="No server is currently running. Launch a server to see its console output here."
                                               FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Border Name="ConsoleContainer" 
                                            Background="Black" 
                                            CornerRadius="4"
                                            Visibility="Collapsed">
                                        <!-- Embedded console will be added here programmatically -->
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
