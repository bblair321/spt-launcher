<Page x:Class="SptLauncherWpf.Pages.DevToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DevTools">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0" >
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="Development Tools" FontSize="28" FontWeight="Bold" 
                           Foreground="#374151" HorizontalAlignment="Center"/>
                <TextBlock Text="Debugging and development utilities" 
                           FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Process Monitor -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="#2563EB" Margin="0,0,8,0"/>
                        <TextBlock Text="Process Monitor" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel >
                        <!-- Process List -->
                        <StackPanel>
                            <TextBlock Text="Running Processes" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" 
                                    CornerRadius="6" Height="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ListView Name="ProcessListView" Height="180">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Id}"/>
                                                <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding ProcessName}"/>
                                                <GridViewColumn Header="CPU" Width="80" DisplayMemberBinding="{Binding CPU}"/>
                                                <GridViewColumn Header="Memory" Width="100" DisplayMemberBinding="{Binding Memory}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Process Actions -->
                        <StackPanel Orientation="Horizontal" >
                            <Button Name="RefreshProcessesButton" Content="Refresh" 
                                    Background="#3B82F6" Foreground="White" BorderThickness="0"
                                    Padding="16,8" FontSize="14" Click="RefreshProcessesButton_Click"/>
                            <Button Name="KillProcessButton" Content="Kill Selected" 
                                    Background="#DC2626" Foreground="White" BorderThickness="0"
                                    Padding="16,8" FontSize="14" Click="KillProcessButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Log Viewer -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,8,0"/>
                        <TextBlock Text="Log Viewer" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel >
                        <!-- Log Controls -->
                        <StackPanel Orientation="Horizontal" >
                            <Button Name="LoadLogsButton" Content="Load Logs" 
                                    Background="#059669" Foreground="White" BorderThickness="0"
                                    Padding="16,8" FontSize="14" Click="LoadLogsButton_Click"/>
                            <Button Name="ClearLogsButton" Content="Clear" 
                                    Background="#6B7280" Foreground="White" BorderThickness="0"
                                    Padding="16,8" FontSize="14" Click="ClearLogsButton_Click"/>
                            <Button Name="ExportLogsButton" Content="Export" 
                                    Background="#3B82F6" Foreground="White" BorderThickness="0"
                                    Padding="16,8" FontSize="14" Click="ExportLogsButton_Click"/>
                        </StackPanel>

                        <!-- Log Display -->
                        <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" 
                                CornerRadius="6" Height="300">
                            <ScrollViewer Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Auto" Padding="12">
                                <TextBlock Name="LogTextBlock" FontFamily="Consolas" FontSize="12" 
                                           Foreground="#10B981" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- System Information -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,8,0"/>
                        <TextBlock Text="System Information" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- System Info -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="System Details" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <StackPanel Name="SystemInfoPanel">
                                <!-- System info will be populated here -->
                            </StackPanel>
                        </StackPanel>

                        <!-- Performance Info -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Performance" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <StackPanel Name="PerformanceInfoPanel">
                                <!-- Performance info will be populated here -->
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Tools -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,8,0"/>
                        <TextBlock Text="Network Tools" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel >
                        <!-- Port Scanner -->
                        <StackPanel>
                            <TextBlock Text="Port Scanner" FontWeight="Medium" 
                                       Foreground="#111827" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0" Name="PortScannerTextBox" 
                                         Text="localhost" FontSize="14"
                                         Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                
                                <Button Grid.Column="1" Name="ScanPortsButton" Content="Scan Ports" 
                                        Background="#3B82F6" Foreground="White" BorderThickness="0"
                                        Padding="16,8" Margin="8,0,0,0" FontSize="14" Click="ScanPortsButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Network Info -->
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" 
                                CornerRadius="6" Padding="12" Height="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Name="NetworkInfoTextBlock" FontFamily="Consolas" FontSize="12" 
                                           Foreground="#374151" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Debug Actions -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="20" Height="20" Fill="#3B82F6" Margin="0,0,8,0"/>
                        <TextBlock Text="Debug Actions" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" >
                        <Button Name="TestConnectionButton" Content="Test SPT Connection" 
                                Background="#059669" Foreground="White" BorderThickness="0"
                                Padding="16,8" FontSize="14" Click="TestConnectionButton_Click"/>
                        <Button Name="ValidateConfigButton" Content="Validate Config" 
                                Background="#3B82F6" Foreground="White" BorderThickness="0"
                                Padding="16,8" FontSize="14" Click="ValidateConfigButton_Click"/>
                        <Button Name="ClearCacheButton" Content="Clear Cache" 
                                Background="#DC2626" Foreground="White" BorderThickness="0"
                                Padding="16,8" FontSize="14" Click="ClearCacheButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
