        <Page x:Class="SptLauncherWpf.Pages.DevToolsPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Title="DevTools"
              Loaded="DevToolsPage_Loaded"
              Unloaded="DevToolsPage_Unloaded"
              UseLayoutRounding="True"
              SnapsToDevicePixels="True"
              RenderOptions.BitmapScalingMode="HighQuality"
              TextOptions.TextFormattingMode="Ideal"
              TextOptions.TextRenderingMode="ClearType"
              RenderOptions.EdgeMode="Unspecified">
    
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,16,0,0" >
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="Development Tools" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Debugging and development utilities" 
                           FontSize="16" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Process Monitor -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Modern Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="SPT Process Monitor" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Real-time process monitoring and management" 
                               FontSize="14" Foreground="{DynamicResource TextSecondaryColor}" 
                               Margin="0,0,0,16"/>

                    <!-- Modern Process List -->
                    <StackPanel Margin="0,0,0,24">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Background="{DynamicResource HoverColor}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="ACTIVE PROCESSES" FontSize="12" FontWeight="Bold" 
                                           Foreground="{DynamicResource TextSecondaryColor}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Name="ProcessCountText" Text="0 processes" FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Process List Container -->
                        <Border Style="{StaticResource ModernCardStyle}" Padding="16" MaxHeight="400">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                                    <StackPanel Name="ProcessListPanel">
                                        <!-- Process cards will be added here dynamically -->
                                    </StackPanel>
                                </ScrollViewer>
                                
                                <!-- Empty State -->
                                <StackPanel Name="EmptyStatePanel" HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" Visibility="Visible">
                                    <Border Width="64" Height="64" Background="{DynamicResource HoverColor}" CornerRadius="32" 
                                            Margin="0,0,0,16">
                                        <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No SPT processes running" FontSize="16" FontWeight="Medium" 
                                               Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Start an SPT server to see processes here" FontSize="14" 
                                               Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Modern Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Name="RefreshProcessesButton" Content="🔄 Refresh" 
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#6B7280" Padding="20,12" FontSize="14" FontWeight="SemiBold"
                                Margin="0,0,12,0" Click="RefreshProcessesButton_Click"/>
                        <Button Name="KillProcessButton" Content="🗑️ Kill Selected" 
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#DC2626" Padding="20,12" FontSize="14" FontWeight="SemiBold"
                                Click="KillProcessButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>



        </StackPanel>
    </ScrollViewer>
</Page>
