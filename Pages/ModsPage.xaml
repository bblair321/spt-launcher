<Page x:Class="SptLauncherWpf.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Mods"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified"
      Loaded="Page_Loaded">

    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Compact toolbar: title + mode + search -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Mods"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryColor}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Button Name="BrowseModeButton" Content="Browse"
                        Style="{StaticResource ModernButtonStyle}"
                        Padding="12,6" FontSize="12"
                        Click="BrowseModeButton_Click"/>
                <Button Name="InstalledModeButton" Content="Installed"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#6B7280"
                        Padding="12,6" FontSize="12" Margin="6,0,0,0"
                        Click="InstalledModeButton_Click"/>
                <Button Name="RefreshInstalledButton" Content="Refresh"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#6B7280"
                        Padding="12,6" FontSize="12" Margin="6,0,0,0"
                        Visibility="Collapsed"
                        Click="RefreshInstalledButton_Click"/>
            </StackPanel>

            <Border Name="BrowseSearchPanel" Grid.Column="2" Margin="0,0,12,0"
                    Background="{DynamicResource CardBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="SearchTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             VerticalContentAlignment="Center"
                             Height="30"
                             KeyDown="SearchTextBox_KeyDown"/>
                    <Button Grid.Column="1" Name="SearchButton" Content="Search"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="12,4" Margin="6,0,0,0" FontSize="12"
                            Click="SearchButton_Click"/>
                    <CheckBox Grid.Column="2" Name="FilterBySptCheckBox"
                              Content="Match SPT"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              IsChecked="True"
                              VerticalAlignment="Center"
                              Margin="10,0,4,0"
                              Checked="FilterBySptCheckBox_Changed"
                              Unchecked="FilterBySptCheckBox_Changed"/>
                </Grid>
            </Border>

            <TextBlock Name="SptContextText"
                       Grid.Column="3"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryColor}"
                       VerticalAlignment="Center"
                       Text="SPT path not set"/>
        </Grid>

        <!-- Hidden subtitle kept for mode text updates -->
        <TextBlock Name="HeaderSubtitleText" Visibility="Collapsed"/>

        <!-- Browse results + details -->
        <Grid Name="BrowseContentPanel" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Name="ModsListColumn" Width="260" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Padding="8" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Name="ResultsText" Text="Search mods to get started"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryColor}"
                               Margin="2,0,2,6"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="ModsListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Name="ModDetailCard" Grid.Column="2" Style="{StaticResource ModernCardStyle}" Padding="0" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Single compact chrome row -->
                    <Border Name="ModDetailHeaderPanel"
                            Padding="10,8"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource CardBackgroundColor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Name="ModDetailTitleText"
                                           Text="Select a mod"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryColor}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"/>
                                <TextBlock Name="ModDetailMetaText"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel Name="ModDetailTabsPanel"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed">
                                <Button Name="ModPageTabButton"
                                        Content="Page"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Padding="10,5"
                                        FontSize="12"
                                        Click="ModPageTabButton_Click"
                                        Margin="0,0,6,0"/>
                                <Button Name="ModVersionsTabButton"
                                        Content="Versions"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Padding="10,5"
                                        FontSize="12"
                                        Click="ModVersionsTabButton_Click"/>
                            </StackPanel>

                            <StackPanel Name="ModDetailActionsPanel"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Border Name="ModPageEmbedHost"
                                Background="#111827"
                                Visibility="Collapsed">
                            <Grid>
                                <wv2:WebView2 Name="ModPageWebView"
                                              DefaultBackgroundColor="#111827"/>
                                <TextBlock Name="ModPageEmbedStatusText"
                                           Text="Loading mod page…"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="16"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Name="ModVersionsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="12"
                                      Visibility="Collapsed">
                            <StackPanel Name="ModDetailsPanel">
                                <TextBlock Text="Select a mod from the list to open its page."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           HorizontalAlignment="Center"
                                           Margin="0,40,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Installed list -->
        <Border Name="InstalledContentPanel" Grid.Row="2" Style="{StaticResource ModernCardStyle}"
                Padding="10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Name="InstalledSummaryText"
                           Text="No SPT path set"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryColor}"
                           Margin="2,0,2,8"/>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="InstalledListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Thin footer -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="StatusText"
                       Text=""
                       FontSize="11"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryColor}"
                       VerticalAlignment="Center"/>
            <StackPanel Name="BrowsePaginationPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Name="PrevPageButton" Content="Prev"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#6B7280"
                        Padding="10,4" FontSize="11"
                        IsEnabled="False"
                        Click="PrevPageButton_Click"/>
                <TextBlock Name="PageInfo" Text="Page 1"
                           FontSize="11"
                           Foreground="{DynamicResource TextPrimaryColor}"
                           VerticalAlignment="Center"
                           Margin="8,0"/>
                <Button Name="NextPageButton" Content="Next"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#6B7280"
                        Padding="10,4" FontSize="11"
                        IsEnabled="False"
                        Click="NextPageButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
