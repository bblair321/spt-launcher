<Page x:Class="SptLauncherWpf.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mods"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified"
      Loaded="Page_Loaded">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Mods"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryColor}"/>
            <TextBlock Name="HeaderSubtitleText"
                       Text="Browse The Forge and manage mods in your SPT folder."
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryColor}"
                       Margin="0,6,0,0"/>
            <TextBlock Name="SptContextText"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryColor}"
                       Margin="0,8,0,0"
                       Text="SPT path not set"/>
        </StackPanel>

        <!-- Browse / Installed switch -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Name="BrowseModeButton" Content="Browse Forge"
                    Style="{StaticResource ModernButtonStyle}"
                    Padding="14,8" FontSize="13"
                    Click="BrowseModeButton_Click"/>
            <Button Name="InstalledModeButton" Content="Installed"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#6B7280"
                    Padding="14,8" FontSize="13" Margin="8,0,0,0"
                    Click="InstalledModeButton_Click"/>
            <Button Name="RefreshInstalledButton" Content="Refresh"
                    Style="{StaticResource ModernButtonStyle}"
                    Background="#6B7280"
                    Padding="14,8" FontSize="13" Margin="8,0,0,0"
                    Visibility="Collapsed"
                    Click="RefreshInstalledButton_Click"/>
        </StackPanel>

        <!-- Browse search -->
        <Border Name="BrowseSearchPanel" Grid.Row="2" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Name="SearchTextBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchTextBox_KeyDown"/>
                <Button Grid.Column="1" Name="SearchButton" Content="Search"
                        Style="{StaticResource ModernButtonStyle}"
                        Padding="16,8" Margin="8,0,0,0" FontSize="13"
                        Click="SearchButton_Click"/>
                <CheckBox Grid.Column="2" Name="FilterBySptCheckBox"
                          Content="Match my SPT version"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          Checked="FilterBySptCheckBox_Changed"
                          Unchecked="FilterBySptCheckBox_Changed"/>
            </Grid>
        </Border>

        <!-- Browse results + details -->
        <Grid Name="BrowseContentPanel" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Name="ResultsText" Text="Search Forge to get started"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryColor}"
                               Margin="4,0,4,8"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Name="ModsListPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" Padding="16" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="ModDetailsPanel">
                        <TextBlock Text="Select a mod"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,40,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Installed list -->
        <Border Name="InstalledContentPanel" Grid.Row="3" Style="{StaticResource ModernCardStyle}"
                Padding="12" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Name="InstalledSummaryText"
                           Text="No SPT path set"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryColor}"
                           Margin="4,0,4,8"/>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="InstalledListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer / pagination / status -->
        <Border Grid.Row="4" Style="{StaticResource ModernCardStyle}" Padding="12,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusText"
                           Text=""
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryColor}"
                           VerticalAlignment="Center"/>
                <StackPanel Name="BrowsePaginationPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="PrevPageButton" Content="Prev"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#6B7280"
                            Padding="12,6" FontSize="12"
                            IsEnabled="False"
                            Click="PrevPageButton_Click"/>
                    <TextBlock Name="PageInfo" Text="Page 1"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryColor}"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                    <Button Name="NextPageButton" Content="Next"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#6B7280"
                            Padding="12,6" FontSize="12"
                            IsEnabled="False"
                            Click="NextPageButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
