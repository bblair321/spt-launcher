<Page x:Class="SptLauncherWpf.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mods"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified">
    
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,16,0,0" >
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="SPT Mods" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Browse and download mods from the SPT Forge" 
                           FontSize="16" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
                
                <!-- Work in Progress Notice -->
                <Border Background="{DynamicResource HoverColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                        CornerRadius="8" Padding="12,8" Margin="0,16,0,0" MaxWidth="600">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🚧" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="This page is currently under development" 
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Authentication Panel -->
            <Border Name="AuthPanel" Style="{StaticResource ModernCardStyle}" 
                    Padding="24" MaxWidth="400" HorizontalAlignment="Center" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                            <TextBlock Text="SPT Mods Authentication" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Sign in to your account to browse and download mods" 
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryColor}" 
                                   Margin="0,0,0,16"/>

                        <StackPanel>
                            <!-- Email -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Email Address" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8" FontSize="14"/>
                                <TextBox Name="EmailTextBox" 
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- Password -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Password" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8" FontSize="14"/>
                                <PasswordBox Name="PasswordBox" FontSize="14"
                                             Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                             Background="{DynamicResource CardBackgroundColor}"/>
                            </StackPanel>

                            <!-- Login Button -->
                            <Button Name="LoginButton" Content="Sign In" 
                                    Style="{StaticResource ModernButtonStyle}"
                                    Click="LoginButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Content (Hidden until authenticated) -->
            <StackPanel Name="MainContentPanel" Visibility="Collapsed" >
                
                <!-- User Info and Logout -->
                <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                            <TextBlock Name="UserInfoText" Text="User" FontSize="14" 
                                       Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Name="LogoutButton" Content="Logout" 
                                Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                Padding="16,8" FontSize="14" Click="LogoutButton_Click"/>
                    </Grid>
                </Border>

                <!-- Search and Filters -->
                <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Search -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Name="SearchTextBox" 
                                     Text="Search mods..." 
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     TextChanged="SearchTextBox_TextChanged"/>
                            
                            <Button Grid.Column="1" Name="SearchButton" Content="Search" 
                                    Style="{StaticResource ModernButtonStyle}"
                                    Padding="16,8" Margin="8,0,0,0" FontSize="14" Click="SearchButton_Click"/>
                        </Grid>

                        <!-- Filters -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Name="FiltersButton" Content="Filters" 
                                    Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                    Padding="16,8" FontSize="14" Click="FiltersButton_Click"/>
                            
                            <TextBlock Grid.Column="1" Name="ResultsText" Text="Showing 0 of 0 mods" 
                                       FontSize="14" Foreground="{DynamicResource TextSecondaryColor}" VerticalAlignment="Center" 
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Filters Panel -->
                        <Border Name="FiltersPanel" Background="{DynamicResource HoverColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" 
                                CornerRadius="12" Padding="16" Visibility="Collapsed" Margin="0,16,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Per Page -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Per Page" FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8" FontSize="14"/>
                                        <ComboBox Name="PerPageComboBox" FontSize="14"
                                                  Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                  Background="{DynamicResource CardBackgroundColor}">
                                            <ComboBoxItem Content="6 per page" Tag="6"/>
                                            <ComboBoxItem Content="12 per page" Tag="12" IsSelected="True"/>
                                            <ComboBoxItem Content="24 per page" Tag="24"/>
                                            <ComboBoxItem Content="50 per page" Tag="50"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Reset Filters -->
                                <Button Name="ResetFiltersButton" Content="Reset Filters" 
                                        Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                        Padding="16,8" FontSize="14" HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Click="ResetFiltersButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Mods Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mod List -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCardStyle}" 
                            Padding="24" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                                <TextBlock Text="Available Mods" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ScrollViewer Name="ModsScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" MaxHeight="400">
                                <StackPanel Name="ModsListPanel">
                                    <!-- Mods will be added here dynamically -->
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Mod Details -->
                    <Border Grid.Column="1" Style="{StaticResource ModernCardStyle}" 
                            Padding="24" Margin="12,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                                <TextBlock Text="Mod Details" FontSize="16" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <StackPanel Name="ModDetailsPanel">
                                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,16">
                                    <Ellipse Width="48" Height="48" Fill="{DynamicResource TextSecondaryColor}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Select a mod to view details" FontSize="14" 
                                               Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pagination -->
                <Border Name="PaginationPanel" Style="{StaticResource ModernCardStyle}" 
                        Padding="24" Visibility="Collapsed" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Name="PaginationInfo" Text="Showing 1 to 12 of 0 results" 
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryColor}" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Name="PrevPageButton" Content="◀" 
                                    Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                    Padding="16,8" FontSize="14" Click="PrevPageButton_Click"/>
                            
                            <TextBlock Name="PageInfo" Text="Page 1 of 1" 
                                       FontSize="14" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center" 
                                       Margin="8,0"/>
                            
                            <Button Name="NextPageButton" Content="▶" 
                                    Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                    Padding="16,8" FontSize="14" Click="NextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
