<Page x:Class="SptLauncherWpf.Pages.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mods">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0" >
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="SPT Mods" FontSize="28" FontWeight="Bold" 
                           Foreground="#374151" HorizontalAlignment="Center"/>
                <TextBlock Text="Browse and download mods from the SPT Forge" 
                           FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Authentication Panel -->
            <Border Name="AuthPanel" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="8" Padding="32" MaxWidth="400" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Ellipse Width="48" Height="48" Fill="#2563EB" Margin="0,0,0,16"/>
                        <TextBlock Text="SPT Mods" FontSize="24" FontWeight="Bold" 
                                   Foreground="#374151" HorizontalAlignment="Center"/>
                        <TextBlock Text="Browse and download mods from the SPT Forge" 
                                   FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Sign in to your account" FontSize="18" FontWeight="SemiBold" 
                                   Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <StackPanel >
                            <!-- Email -->
                            <StackPanel>
                                <TextBlock Text="Email Address" FontWeight="Medium" 
                                           Foreground="#111827" Margin="0,0,0,8"/>
                                <TextBox Name="EmailTextBox" FontSize="14"
                                         Padding="12,12" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Password -->
                            <StackPanel>
                                <TextBlock Text="Password" FontWeight="Medium" 
                                           Foreground="#111827" Margin="0,0,0,8"/>
                                <PasswordBox Name="PasswordBox" FontSize="14"
                                             Padding="12,12" BorderBrush="#D1D5DB" BorderThickness="1"/>
                            </StackPanel>

                            <!-- Login Button -->
                            <Button Name="LoginButton" Content="Sign In" 
                                    Background="#2563EB" Foreground="White" BorderThickness="0"
                                    Padding="16,12" FontSize="14" Click="LoginButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main Content (Hidden until authenticated) -->
            <StackPanel Name="MainContentPanel" Visibility="Collapsed" >
                
                <!-- User Info and Logout -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                        CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="16" Height="16" Fill="#3B82F6" Margin="0,0,8,0"/>
                            <TextBlock Name="UserInfoText" Text="User" FontSize="14" 
                                       Foreground="#111827" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Name="LogoutButton" Content="Logout" 
                                Background="#6B7280" Foreground="White" BorderThickness="0"
                                Padding="12,6" FontSize="14" Click="LogoutButton_Click"/>
                    </Grid>
                </Border>

                <!-- Search and Filters -->
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                        CornerRadius="8" Padding="16">
                    <StackPanel >
                        <!-- Search -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0" Name="SearchTextBox" 
                                     Text="Search mods..." FontSize="14"
                                     Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1"
                                     TextChanged="SearchTextBox_TextChanged"/>
                            
                            <Button Grid.Column="1" Name="SearchButton" Content="Search" 
                                    Background="#3B82F6" Foreground="White" BorderThickness="0"
                                    Padding="16,8" Margin="8,0,0,0" FontSize="14" Click="SearchButton_Click"/>
                        </Grid>

                        <!-- Filters -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Name="FiltersButton" Content="Filters" 
                                    Background="#F3F4F6" Foreground="#374151" BorderThickness="0"
                                    Padding="12,8" FontSize="14" Click="FiltersButton_Click"/>
                            
                            <TextBlock Grid.Column="1" Name="ResultsText" Text="Showing 0 of 0 mods" 
                                       FontSize="14" Foreground="#6B7280" VerticalAlignment="Center" 
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Filters Panel -->
                        <Border Name="FiltersPanel" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" 
                                CornerRadius="6" Padding="16" Visibility="Collapsed">
                            <StackPanel >
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Per Page -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Per Page" FontWeight="Medium" 
                                                   Foreground="#111827" Margin="0,0,0,8"/>
                                        <ComboBox Name="PerPageComboBox" FontSize="14"
                                                  Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1">
                                            <ComboBoxItem Content="6 per page" Tag="6"/>
                                            <ComboBoxItem Content="12 per page" Tag="12" IsSelected="True"/>
                                            <ComboBoxItem Content="24 per page" Tag="24"/>
                                            <ComboBoxItem Content="50 per page" Tag="50"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Reset Filters -->
                                <Button Name="ResetFiltersButton" Content="Reset Filters" 
                                        Background="#6B7280" Foreground="White" BorderThickness="0"
                                        Padding="12,8" FontSize="14" HorizontalAlignment="Right" 
                                        Click="ResetFiltersButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Mods Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mod List -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                            CornerRadius="8" Padding="16" Margin="0,0,12,0">
                        <ScrollViewer Name="ModsScrollViewer" VerticalScrollBarVisibility="Auto" Height="400">
                            <StackPanel Name="ModsListPanel">
                                <!-- Mods will be added here dynamically -->
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Mod Details -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                            CornerRadius="8" Padding="16" Margin="12,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Mod Details" FontSize="18" FontWeight="SemiBold" 
                                       Foreground="#111827" Margin="0,0,0,16"/>
                            
                            <StackPanel Name="ModDetailsPanel">
                                <StackPanel HorizontalAlignment="Center" Margin="0,32,0,16">
                                    <Ellipse Width="48" Height="48" Fill="#9CA3AF" Margin="0,0,0,8"/>
                                    <TextBlock Text="Select a mod to view details" FontSize="14" 
                                               Foreground="#6B7280" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pagination -->
                <Border Name="PaginationPanel" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" 
                        CornerRadius="8" Padding="16" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Name="PaginationInfo" Text="Showing 1 to 12 of 0 results" 
                                   FontSize="14" Foreground="#6B7280" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" >
                            <Button Name="PrevPageButton" Content="◀" 
                                    Background="#F3F4F6" Foreground="#374151" BorderThickness="0"
                                    Padding="12,8" FontSize="14" Click="PrevPageButton_Click"/>
                            
                            <TextBlock Name="PageInfo" Text="Page 1 of 1" 
                                       FontSize="14" Foreground="#374151" VerticalAlignment="Center" 
                                       Margin="8,0"/>
                            
                            <Button Name="NextPageButton" Content="▶" 
                                    Background="#F3F4F6" Foreground="#374151" BorderThickness="0"
                                    Padding="12,8" FontSize="14" Click="NextPageButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
