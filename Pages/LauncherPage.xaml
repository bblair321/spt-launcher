<Page x:Class="SptLauncherWpf.Pages.LauncherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Launcher">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,16,0,0">
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="SPT Launcher" FontSize="28" FontWeight="Bold" 
                           Foreground="#374151" HorizontalAlignment="Center"/>
                <TextBlock Text="Launch and manage your SPT-AKI installation" 
                           FontSize="16" Foreground="#6B7280" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Modern Status Card -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="16" Height="16" Fill="#2563EB" Margin="0,0,8,0"/>
                        <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Status Icon -->
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#10B981" 
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        
                        <!-- Status Text -->
                        <TextBlock Grid.Column="1" Name="StatusText" Text="Ready" 
                                   FontSize="14" Foreground="#374151" VerticalAlignment="Center"/>
                        
                        <!-- Refresh Button -->
                        <Button Grid.Column="2" Name="RefreshButton" Content="Refresh" 
                                Background="#F3F4F6" Foreground="#6B7280" BorderThickness="0"
                                Padding="12,6" FontSize="12" Click="RefreshButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Modern SPT Launcher Configuration -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="#2563EB" Margin="0,0,8,0"/>
                        <TextBlock Text="SPT Launcher Executable" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="#374151" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel>
                        <!-- Path Input -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Launcher Path" FontWeight="Medium" 
                                       Foreground="#374151" Margin="0,0,0,8" FontSize="14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0" Name="LauncherPathTextBox" 
                                         Text="D:\SPT\SPT\SPT.Launcher.exe" FontSize="14"
                                         Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1"
                                         Background="White"/>
                                
                                <Button Grid.Column="1" Name="BrowseButton" Content="Browse" 
                                        Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                        Padding="16,8" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                            </Grid>
                        </StackPanel>

                                <!-- Modern Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                                    <Button Name="LaunchButton" Content="🚀 Launch SPT" 
                                            Style="{StaticResource ModernButtonStyle}" Click="LaunchButton_Click"
                                            Margin="0,0,12,0"/>
                                    <Button Name="StopButton" Content="⏹ Stop" 
                                            Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                            Padding="20,12" FontSize="14" FontWeight="SemiBold" 
                                            IsEnabled="False" Click="StopButton_Click"/>
                                </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Modern Fika Configuration -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Ellipse Width="16" Height="16" Fill="#2563EB" Margin="0,0,8,0"/>
                            <TextBlock Text="Fika Co-op Configuration" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <Button Grid.Column="1" Name="ToggleFikaButton" Content="Configure" 
                                Style="{StaticResource ModernButtonStyle}" Background="#2563EB"
                                Padding="16,8" FontSize="14" Click="ToggleFikaButton_Click"/>
                    </Grid>

                    <!-- Fika Settings Panel -->
                    <StackPanel Name="FikaSettingsPanel" Visibility="Collapsed" >
                        <!-- Enable Fika Checkbox -->
                        <CheckBox Name="EnableFikaCheckBox" Content="Enable Fika Co-op Mode" 
                                  FontWeight="Medium" Foreground="#111827" Checked="EnableFikaCheckBox_Changed" 
                                  Unchecked="EnableFikaCheckBox_Changed"/>

                        <!-- Fika Configuration Fields -->
                        <StackPanel Name="FikaConfigPanel" Visibility="Collapsed" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Server Address -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Server Address" FontWeight="Medium" 
                                               Foreground="#111827" Margin="0,0,0,8"/>
                                    <TextBox Name="ServerAddressTextBox" 
                                             Text="192.168.1.100" FontSize="14"
                                             Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                </StackPanel>

                                <!-- Server Port -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Server Port" FontWeight="Medium" 
                                               Foreground="#111827" Margin="0,0,0,8"/>
                                    <TextBox Name="ServerPortTextBox" Text="6969" FontSize="14"
                                             Padding="12,8" BorderBrush="#D1D5DB" BorderThickness="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal">
                                <Button Name="SaveConfigButton" Content="Save Configuration" 
                                        Background="#059669" Foreground="White" BorderThickness="0"
                                        Padding="16,8" FontSize="14" Click="SaveConfigButton_Click"/>
                                <Button Name="ReloadConfigButton" Content="Reload" 
                                        Background="#6B7280" Foreground="White" BorderThickness="0"
                                        Padding="16,8" FontSize="14" Click="ReloadConfigButton_Click"/>
                            </StackPanel>

                            <!-- Config Info -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" 
                                    CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Configuration Location:" FontWeight="Medium" 
                                               Foreground="#111827" Margin="0,0,0,4"/>
                                    <TextBlock Name="ConfigPathText" Text="D:\SPT\config.json" 
                                               FontFamily="Consolas" FontSize="12" 
                                               Foreground="#6B7280" Margin="0,0,0,8"/>
                                    <TextBlock Text="This configuration will be applied to your SPT launcher's config.json file. When Fika mode is enabled, the launcher will connect to the specified server." 
                                               FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
