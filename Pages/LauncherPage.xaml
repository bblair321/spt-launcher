<Page x:Class="SptLauncherWpf.Pages.LauncherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Launcher"
      Loaded="LauncherPage_Loaded"
      Unloaded="LauncherPage_Unloaded"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified">
    
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,16,0,0">
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                <TextBlock Text="SPT Launcher" FontSize="28" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Launch and manage your SPT-AKI installation" 
                           FontSize="16" Foreground="{DynamicResource TextSecondaryColor}" HorizontalAlignment="Center" 
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- SPT Installation Section -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="SPT Installation" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Do you need to install SPT?" 
                               FontSize="14" Foreground="{DynamicResource TextPrimaryColor}" 
                               Margin="0,0,0,12"/>
                    
                    <Button Name="InstallSptButton" Content="📥 Install Latest SPT Version" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Click="InstallSptButton_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- FIKA Installation Section -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="FIKA Installation" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Do you need to install FIKA Co-op?" 
                               FontSize="14" Foreground="{DynamicResource TextPrimaryColor}" 
                               Margin="0,0,0,12"/>
                    
                    <Button Name="InstallFikaButton" Content="📥 Install Latest FIKA Version" 
                            Style="{StaticResource ModernButtonStyle}" 
                            Click="InstallFikaButton_Click"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Modern Status Card -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Status Icon -->
                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource PrimaryColor}" 
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        
                        <!-- Status Text -->
                        <TextBlock Grid.Column="1" Name="StatusText" Text="Ready" 
                                   FontSize="14" Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                        
                        <!-- Refresh Button -->
                        <Button Grid.Column="2" Name="RefreshButton" Content="Refresh" 
                                Background="{DynamicResource HoverColor}" Foreground="{DynamicResource TextPrimaryColor}" BorderThickness="0"
                                Padding="12,6" FontSize="12" Click="RefreshButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Fika Co-op Configuration -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="Fika Co-op Configuration" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,0">
                        <CheckBox Name="EnableFikaCheckBox" Content="Enable Fika Co-op" 
                                  FontWeight="Medium" Foreground="{DynamicResource TextPrimaryColor}" FontSize="14" Padding="0,8"
                                  Checked="EnableFikaCheckBox_Changed" Unchecked="EnableFikaCheckBox_Changed">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="CheckBox">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0" 
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"
                                                                      Margin="0,0,12,0"/>
                                                    <Border x:Name="border" Grid.Column="1" Width="20" Height="20" 
                                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" 
                                                            Background="{DynamicResource CardBackgroundColor}" CornerRadius="4" 
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right"/>
                                                    <Path x:Name="checkMark" Grid.Column="1" Data="M 2 6 L 6 10 L 14 2" 
                                                          Stroke="{DynamicResource PrimaryColor}" StrokeThickness="2" 
                                                          Visibility="Collapsed" Margin="3,3,3,3" 
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryColor}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextSecondaryColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        
                        <!-- IP Address Editor (collapsible) -->
                        <StackPanel Name="FikaIpEditorPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="IP Address" FontWeight="Medium" 
                                           Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8" FontSize="14"/>
                                <TextBox Name="FikaIpTextBox" 
                                         FontSize="14"
                                         Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                         Background="{DynamicResource CardBackgroundColor}"/>
                            </StackPanel>
                            
                            <Button Name="SaveFikaIpButton" Content="Save IP Address" 
                                    Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                    Padding="16,8" FontSize="14" FontWeight="SemiBold"
                                    HorizontalAlignment="Left" Click="SaveFikaIpButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Modern SPT Launcher Configuration -->
            <Border Style="{StaticResource ModernCardStyle}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource PrimaryColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="SPT Launcher Executable" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel>
                        <!-- Path Input -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Launcher Path" FontWeight="Medium" 
                                       Foreground="{DynamicResource TextPrimaryColor}" Margin="0,0,0,8" FontSize="14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBox Grid.Column="0" Name="LauncherPathTextBox" 
                                         Text="" FontSize="14"
                                         Padding="12,8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                         Background="{DynamicResource CardBackgroundColor}"
                                         TextChanged="LauncherPathTextBox_TextChanged"/>
                                
                                <Button Grid.Column="1" Name="BrowseButton" Content="Browse" 
                                        Style="{StaticResource ModernButtonStyle}" Background="#6B7280"
                                        Padding="16,8" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                            </Grid>
                            <TextBlock Name="PathStatusText" Text="Please select your SPT Launcher executable using the Browse button." 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryColor}" 
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Modern Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <Button Name="LaunchButton" Content="🚀 Launch SPT" 
                                    Style="{StaticResource ModernButtonStyle}" Click="LaunchButton_Click"
                                    Margin="0,0,12,0"/>
                            <!-- Use Border as clickable stop button to bypass Button control issues -->
                            <Border Name="StopButtonBorder" 
                                    Background="#6B7280" 
                                    CornerRadius="12"
                                    Padding="20,12"
                                    Cursor="Hand"
                                    MouseDown="StopButtonBorder_MouseDown"
                                    MouseEnter="StopButtonBorder_MouseEnter"
                                    MouseLeave="StopButtonBorder_MouseLeave">
                                <TextBlock Text="⏹ Stop" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
