<Page x:Class="SptLauncherWpf.Pages.LauncherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Launcher"
      Loaded="LauncherPage_Loaded"
      Unloaded="LauncherPage_Unloaded"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="ClearType"
      RenderOptions.EdgeMode="Unspecified">

    <Page.Resources>
        <Style x:Key="StatusPillBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
        </Style>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#4B5563"/>
        </Style>
        <Style x:Key="LinkToggleStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,4,0,16" MaxWidth="900" HorizontalAlignment="Stretch">

                <!-- Guided first-run wizard -->
                <Border Name="FirstRunWizardPanel"
                        Style="{StaticResource ModernCardStyle}"
                        Padding="28,24"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock Text="Get set up"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       VerticalAlignment="Center"/>
                            <Button Name="FirstRunSkipButton"
                                    Content="Skip for now"
                                    Style="{StaticResource LinkToggleStyle}"
                                    Click="FirstRunSkipButton_Click"
                                    DockPanel.Dock="Right"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Name="FirstRunStepLabel"
                                   Text="Step 1 of 3"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryColor}"
                                   Margin="0,0,0,16"/>

                        <!-- Step 1: install SPT first (nothing to browse for yet) -->
                        <StackPanel Name="FirstRunStep1Panel">
                            <TextBlock Text="Install SPT"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="If you don’t have SPT yet, install it first. The official installer will create SPT.Launcher.exe — we’ll find that afterward."
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Name="FirstRunInstallSptButton"
                                        Content="Install SPT"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Background="{DynamicResource PrimaryColor}"
                                        Padding="18,10"
                                        Click="FirstRunInstallSptButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button Name="FirstRunAlreadyInstalledButton"
                                        Content="I already have SPT"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="FirstRunAlreadyInstalledButton_Click"/>
                            </StackPanel>
                            <TextBlock Name="FirstRunInstallStatusText"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Remember the folder you install to — you’ll point us at SPT.Launcher.exe next."/>
                        </StackPanel>

                        <!-- Step 2: locate launcher after install -->
                        <StackPanel Name="FirstRunStep2Panel" Visibility="Collapsed">
                            <TextBlock Text="Find SPT.Launcher.exe"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Text="After installing, SPT.Launcher.exe is in your SPT folder (often next to SPT.Server.exe). Auto-detect usually finds it; otherwise Browse to that file."
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Name="FirstRunDetectButton"
                                        Content="Auto-detect"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Background="{DynamicResource PrimaryColor}"
                                        Padding="18,10"
                                        Click="FirstRunDetectButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button Name="FirstRunBrowseButton"
                                        Content="Browse…"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="FirstRunBrowseButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button Name="FirstRunRecheckSptButton"
                                        Content="Recheck"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="FirstRunRecheckSptButton_Click"/>
                            </StackPanel>
                            <TextBlock Name="FirstRunPathStatusText"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                            <Button Name="FirstRunBackToInstallButton"
                                    Content="Back — I still need to install SPT"
                                    Style="{StaticResource LinkToggleStyle}"
                                    Margin="0,14,0,0"
                                    Click="FirstRunBackToInstallButton_Click"/>
                        </StackPanel>

                        <!-- Step 3: done -->
                        <StackPanel Name="FirstRunStep3Panel" Visibility="Collapsed">
                            <TextBlock Text="You're ready"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       Margin="0,0,0,6"/>
                            <TextBlock Name="FirstRunReadyDetailText"
                                       Text="SPT looks good. You can launch from the Play card, check Tarkov/Fika readiness, or tweak setup anytime."
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>
                            <Button Name="FirstRunFinishButton"
                                    Content="Continue to launcher"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="{DynamicResource PrimaryColor}"
                                    Padding="18,10"
                                    HorizontalAlignment="Left"
                                    Click="FirstRunFinishButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Name="MainLauncherContent">
                <!-- Play hero + compact readiness -->
                <Border Name="PlayHeroCard" Style="{StaticResource ModernCardStyle}" Padding="0" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Name="PlayHeroAccent"
                                Grid.Column="0"
                                Background="{DynamicResource StatusInfoColor}"
                                CornerRadius="16,0,0,16"/>
                        <StackPanel Grid.Column="1" Margin="20,20,24,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Name="PlayStatusHeadline"
                                           Text="Set your SPT launcher path to begin"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryColor}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Name="PlayStatusDetail"
                                           Text="Launch SPT when your install is ready."
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button Name="LaunchButton"
                                        Content="Launch SPT"
                                        Style="{StaticResource ModernButtonStyle}"
                                        Background="{DynamicResource PrimaryColor}"
                                        Padding="26,12"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Click="LaunchButton_Click"
                                        Margin="0,0,8,0"/>
                                <Border Name="StopButtonBorder"
                                        Background="#6B7280"
                                        CornerRadius="12"
                                        Padding="20,12"
                                        Cursor="Hand"
                                        MouseDown="StopButtonBorder_MouseDown"
                                        MouseEnter="StopButtonBorder_MouseEnter"
                                        MouseLeave="StopButtonBorder_MouseLeave">
                                    <TextBlock Text="Stop"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Compact Ready / Needs attention strip -->
                        <Border Name="ReadinessSummaryStrip"
                                Background="{DynamicResource HoverColor}"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,16,0,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="ReadinessSummaryStrip_MouseLeftButtonUp">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button Name="RefreshEftStatusButton"
                                            Content="Recheck"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="RefreshEftStatusButton_Click"
                                            Margin="0,0,8,0"/>
                                    <Button Name="ReadinessDetailsToggleButton"
                                            Content="Details"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="ReadinessDetailsToggleButton_Click"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Border Name="ReadinessSummaryDot"
                                            Width="10" Height="10"
                                            CornerRadius="5"
                                            Background="#22C55E"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Name="ReadinessSummaryTitle"
                                                   Text="Checking readiness…"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryColor}"/>
                                        <TextBlock Name="ReadinessSummaryDetail"
                                                   Text="SPT · Tarkov · Fika"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryColor}"
                                                   Margin="0,2,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Readiness details (collapsed when everything looks good) -->
                <Border Name="ReadinessDetailsCard"
                        Style="{StaticResource ModernCardStyle}"
                        Padding="20"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Readiness details"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}"
                                   Margin="0,0,0,12"/>

                        <!-- SPT row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SPT" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Name="SptVersionText" Text="Not detected" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                                <Border Name="SptStatusPill" Style="{StaticResource StatusPillBorder}" Margin="10,0,0,0">
                                    <TextBlock Name="SptUpdateStatusText" Text="—" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryColor}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Name="UpdateNowButton" Content="Update SPT"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Visibility="Collapsed" Click="UpdateNowButton_Click" Margin="8,0,0,0"/>
                            <Button Grid.Column="3" Name="InstallSptButton" Content="Install SPT"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="InstallSptButton_Click" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Tarkov row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tarkov" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Name="EftVersionText" Text="Not detected" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                                    <Border Name="EftStatusPill" Style="{StaticResource StatusPillBorder}" Margin="10,0,0,0">
                                        <TextBlock Name="EftStatusText" Text="—" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryColor}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Name="EftRequiredVersionText"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Grid.Column="2" Name="UpdateTarkovButton" Content="Update Tarkov"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Visibility="Collapsed" Click="UpdateTarkovButton_Click" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Live Tarkov newer than SPT patcher -->
                        <Border Name="EftPatcherGuidancePanel"
                                Style="{StaticResource StatusMessageStyle}"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{DynamicResource StatusWarningColor}"
                                        CornerRadius="2"
                                        Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="No downgrade patcher found for your live Tarkov yet"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryColor}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Name="EftPatcherGuidanceText"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10"
                                               Text="SPT needs a patcher from your live Tarkov version down to the SPT client version. New EFT updates usually get a patcher within a day or two.&#10;&#10;What you can do:&#10;1. Wait for the SPT team to publish a patcher for your version, then Recheck.&#10;2. Keep live Tarkov updated — the official SPT installer uses the newest matching patcher when it’s available.&#10;3. Check SPT Releases for installer/patcher notes."/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Name="OpenSptReleasesButton"
                                                Content="Open SPT Releases"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="OpenSptReleasesButton_Click"
                                                Margin="0,0,8,0"/>
                                        <Button Name="OpenBsgForPatcherButton"
                                                Content="Open BSG Launcher"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="UpdateTarkovButton_Click"
                                                Margin="0,0,8,0"/>
                                        <Button Name="RecheckPatcherButton"
                                                Content="Recheck"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Click="RefreshEftStatusButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Fika row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fika" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Name="FikaVersionText" Text="Not detected" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryColor}" VerticalAlignment="Center"/>
                                <Border Name="FikaStatusPill" Style="{StaticResource StatusPillBorder}" Margin="10,0,0,0">
                                    <TextBlock Name="FikaUpdateStatusText" Text="—" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryColor}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Name="UpdateFikaButton" Content="Update Fika"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Visibility="Collapsed" Click="UpdateFikaButton_Click" Margin="8,0,0,0"/>
                            <Button Grid.Column="3" Name="InstallFikaButton" Content="Install Fika"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="InstallFikaButton_Click" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Compact update progress (shared SPT update UI) -->
                        <StackPanel Name="SptUpdateStatusPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Name="SptDownloadDetailsText"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       Margin="0,0,0,6"
                                       Visibility="Collapsed"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Name="DownloadInstallerOnlyButton"
                                        Content="Download Installer Only"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="DownloadInstallerOnlyButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button Name="CancelUpdateButton"
                                        Content="Cancel"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Visibility="Collapsed"
                                        Click="CancelUpdateButton_Click"/>
                            </StackPanel>
                            <ProgressBar Name="SptUpdateProgressBar"
                                         Height="6"
                                         Visibility="Collapsed"
                                         Minimum="0" Maximum="100"/>
                            <TextBlock Name="SptUpdateProgressText"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       Margin="0,6,0,0"
                                       Visibility="Collapsed"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Post-update / install verification -->
                        <Border Name="UpdateVerifyPanel"
                                Style="{StaticResource StatusMessageStyle}"
                                Margin="0,14,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Name="UpdateVerifyAccent"
                                        Grid.Column="0"
                                        Background="{DynamicResource StatusInfoColor}"
                                        CornerRadius="2"
                                        Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Name="UpdateVerifyTitleText"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryColor}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Name="UpdateVerifyDetailText"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryColor}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Name="UpdateVerifyDismissButton"
                                        Grid.Column="2"
                                        Content="Dismiss"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="UpdateVerifyDismissButton_Click"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Hidden panel kept for Fika update visibility toggles -->
                        <StackPanel Name="FikaUpdateStatusPanel" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Setup & advanced (collapsed by default when path is valid) -->
                <Border Style="{StaticResource ModernCardStyle}" Padding="18,14" Margin="0,0,0,8">
                    <StackPanel>
                        <Button Name="AdvancedToggleButton"
                                Content="Show setup"
                                Style="{StaticResource LinkToggleStyle}"
                                Click="AdvancedToggleButton_Click"/>

                        <StackPanel Name="AdvancedPanel" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="SPT launcher path"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       Margin="0,0,0,6"
                                       FontSize="13"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Name="LauncherPathTextBox"
                                         FontSize="13"
                                         Padding="12,8"
                                         BorderBrush="{DynamicResource BorderColor}"
                                         BorderThickness="1"
                                         Background="{DynamicResource CardBackgroundColor}"
                                         TextChanged="LauncherPathTextBox_TextChanged"/>
                                <Button Grid.Column="1" Name="BrowseButton" Content="Browse"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="BrowseButton_Click"/>
                            </Grid>
                            <TextBlock Name="PathStatusText"
                                       Text="Select your SPT.Launcher.exe path."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryColor}"
                                       Margin="0,0,0,0"
                                       TextWrapping="Wrap"/>

                            <StackPanel Name="SptFolderActionsPanel" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Name="OpenSptFolderButton"
                                        Content="Open SPT Folder"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="OpenSptFolderButton_Click"
                                        Margin="0,0,8,0"/>
                                <Button Name="ReinstallSptButton"
                                        Content="Reinstall SPT"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="ReinstallSptButton_Click"/>
                            </StackPanel>

                            <!-- Shown only when a backup path exists -->
                            <StackPanel Name="SptRecoveryPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                <TextBlock Text="Recovery"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryColor}"
                                           Margin="0,0,0,8"/>
                                <Button Name="RestoreBackupButton"
                                        Content="Restore Backup"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="RestoreBackupButton_Click"
                                        HorizontalAlignment="Left"/>
                                <TextBlock Name="LastBackupPathText"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryColor}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Toast Notification -->
        <Border Name="ToastNotification"
                Background="{DynamicResource SurfaceColor}"
                BorderBrush="{DynamicResource PrimaryColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Opacity="0"
                Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform X="0" Y="0"/>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="ToastMessage"
                           Text="IP was applied"
                           Foreground="{DynamicResource TextPrimaryColor}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <Ellipse Width="8" Height="8"
                         Fill="{DynamicResource PrimaryColor}"
                         VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
