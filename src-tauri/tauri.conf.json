{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SPT Launcher",
  "version": "1.0.1",
  "identifier": "com.spt.launcher",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SPT Launcher",
        "width": 900,
        "height": 700,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
