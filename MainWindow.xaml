<Window x:Class="SptLauncherWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPT Launcher" Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBackgroundColor}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.EdgeMode="Unspecified">
    
    <Border Background="{DynamicResource ChromeBackgroundColor}" Margin="0"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid Margin="0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Status / update banner -->
                <RowDefinition Height="Auto"/> <!-- Tab Navigation -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Quiet title bar -->
            <Border Name="TitleBarBorder" Grid.Row="0" Height="48" Margin="0"
                    Background="{DynamicResource ChromeBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPT Launcher"
                                       Foreground="{DynamicResource ChromeTextColor}"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock Name="VersionText"
                                       Text="v3.0.0"
                                       Foreground="{DynamicResource ChromeMutedTextColor}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Button Name="ThemeToggleButton" Grid.Column="1" Height="30" Background="Transparent" BorderThickness="0" 
                            Click="ThemeToggleButton_Click" Cursor="Hand" Margin="0,0,6,0" ToolTip="Toggle theme" VerticalAlignment="Center"
                            Padding="10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Name="ThemeToggleIcon" Text="Dark"
                                   Foreground="{DynamicResource ChromeMutedTextColor}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Name="MinimizeButton" Width="40" Height="30" Background="Transparent" BorderThickness="0" 
                                Click="MinimizeButton_Click" Cursor="Hand" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="−" Foreground="{DynamicResource ChromeTextColor}" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Name="MaximizeButton" Width="40" Height="30" Background="Transparent" BorderThickness="0" 
                                Click="MaximizeButton_Click" Cursor="Hand" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverColor}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="□" Foreground="{DynamicResource ChromeTextColor}" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Name="CloseButton" Width="40" Height="30" Background="Transparent" BorderThickness="0" 
                                Click="CloseButton_Click" Cursor="Hand" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StatusErrorColor}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="×" Foreground="{DynamicResource ChromeTextColor}" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Unified status / update banner -->
            <Border Name="UpdateNotificationBanner" Grid.Row="1"
                    Style="{StaticResource StatusMessageStyle}"
                    Margin="16,10,16,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Name="UpdateBannerAccent" Grid.Column="0"
                            Background="{DynamicResource StatusInfoColor}"
                            CornerRadius="2"
                            Margin="0,0,12,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Name="UpdateNotificationText" 
                                   Text="A new version is available" 
                                   Foreground="{DynamicResource TextPrimaryColor}" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Name="UpdateVersionText" 
                                   Text="" 
                                   Foreground="{DynamicResource TextSecondaryColor}" 
                                   FontSize="12" 
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="UpdateDownloadButton" 
                                Content="Download" 
                                Style="{StaticResource ModernButtonStyle}"
                                Background="{DynamicResource StatusSuccessColor}"
                                Padding="14,8" 
                                Margin="0,0,8,0"
                                Click="UpdateDownloadButton_Click"/>
                        <Button Name="UpdateDismissButton" 
                                Content="Dismiss" 
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#4B5563"
                                Padding="12,8"
                                Click="UpdateDismissButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quiet tabs -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <Button Name="LauncherTabButton" Content="Launcher" Tag="launcher"
                            Click="TabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button Name="ServersTabButton" Content="Servers" Tag="servers"
                            Click="TabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button Name="ModsTabButton" Content="Mods" Tag="mods"
                            Click="TabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button Name="SettingsTabButton" Content="Settings" Tag="settings"
                            Click="TabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Button Name="DevToolsTabButton" Content="Tools" Tag="devtools"
                            Click="TabButton_Click"
                            Style="{StaticResource TabButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="3" Background="{DynamicResource BackgroundColor}" Margin="0">
                <Frame Name="ContentFrame" NavigationUIVisibility="Hidden" Background="{DynamicResource BackgroundColor}" Margin="28,20"/>
            </Grid>
        </Grid>
    </Border>
</Window>
