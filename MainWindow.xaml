<Window x:Class="SptLauncherWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPT Launcher" Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#2563EB"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.EdgeMode="Unspecified">
    
    <Border Background="#2563EB" Margin="0">
        <Grid Margin="0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Update Notification Banner -->
                <RowDefinition Height="Auto"/> <!-- Tab Navigation -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Modern Title Bar -->
            <Border Grid.Row="0" Height="48" Margin="0,0,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3B82F6" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="0.35"/>
                        <GradientStop Color="#1E40AF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Modern App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SPT Launcher" Foreground="White" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" LineHeight="20"/>
                            <TextBlock Name="VersionText" Text="v3.0.0" Foreground="#E0E7FF" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,0" Opacity="0.9"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Theme Toggle Button -->
                    <Button Name="ThemeToggleButton" Grid.Column="1" Height="32" Background="Transparent" BorderThickness="0" 
                            Click="ThemeToggleButton_Click" Cursor="Hand" Margin="0,0,8,0" ToolTip="Toggle theme" VerticalAlignment="Center"
                            Padding="10,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3B82F6"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#60A5FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Name="ThemeToggleIcon" Text="Dark" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    
                    <!-- Modern Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Name="MinimizeButton" Width="46" Height="32" Background="Transparent" BorderThickness="0" 
                                Click="MinimizeButton_Click" Cursor="Hand" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3B82F6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#60A5FA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="−" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Name="MaximizeButton" Width="46" Height="32" Background="Transparent" BorderThickness="0" 
                                Click="MaximizeButton_Click" Cursor="Hand" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3B82F6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#60A5FA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="□" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Name="CloseButton" Width="46" Height="32" Background="#EF4444" BorderThickness="0" 
                                Click="CloseButton_Click" Cursor="Hand" Margin="2">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#DC2626"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#B91C1C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="×" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update Notification Banner -->
            <Border Name="UpdateNotificationBanner" Grid.Row="1" 
                    Background="{DynamicResource PrimaryColor}" 
                    Padding="16,12" 
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Name="UpdateNotificationText" 
                                   Text="A new version is available" 
                                   Foreground="White" 
                                   FontWeight="SemiBold" 
                                   FontSize="14"/>
                        <TextBlock Name="UpdateVersionText" 
                                   Text="" 
                                   Foreground="#E0E7FF" 
                                   FontSize="12" 
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Name="UpdateDownloadButton" 
                                Content="Download" 
                                Background="#10B981" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Padding="16,8" 
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Click="UpdateDownloadButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#059669"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Name="UpdateDismissButton" 
                                Content="✕" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0" 
                                Width="32" 
                                Height="32"
                                Cursor="Hand"
                                Click="UpdateDismissButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3B82F6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- Tab Navigation -->
        <Border Grid.Row="2" BorderThickness="0" Padding="16,6">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#3B82F6" Offset="0"/>
                    <GradientStop Color="#2563EB" Offset="0.35"/>
                    <GradientStop Color="#1E40AF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Button Name="LauncherTabButton" Content="Launcher" Tag="launcher"
                        Click="TabButton_Click" Height="36" Padding="16,8"
                        Style="{StaticResource TabButtonStyle}" Background="{DynamicResource PrimaryColor}" FontWeight="SemiBold"/>
                <Button Name="ServersTabButton" Content="Servers" Tag="servers"
                        Click="TabButton_Click" Height="36" Padding="16,8"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Name="ModsTabButton" Content="Mods" Tag="mods"
                        Click="TabButton_Click" Height="36" Padding="16,8"
                        Style="{StaticResource TabButtonStyle}"
                        Visibility="Collapsed"/>
                <Button Name="SettingsTabButton" Content="Settings" Tag="settings"
                        Click="TabButton_Click" Height="36" Padding="16,8"
                        Style="{StaticResource TabButtonStyle}"/>
                <Button Name="DevToolsTabButton" Content="Tools" Tag="devtools"
                        Click="TabButton_Click" Height="36" Padding="16,8"
                        Style="{StaticResource TabButtonStyle}"/>
            </StackPanel>
        </Border>

            <!-- Content Area -->
            <Grid Grid.Row="3" Background="{DynamicResource BackgroundColor}" Margin="0">
                <Frame Name="ContentFrame" NavigationUIVisibility="Hidden" Background="{DynamicResource BackgroundColor}" Margin="28,20"/>
            </Grid>
        </Grid>
    </Border>
</Window>
