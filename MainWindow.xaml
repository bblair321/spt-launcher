<Window x:Class="SptLauncherWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SPT Launcher" Height="800" Width="1200"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.EdgeMode="Unspecified">
    
    <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <Grid Margin="0">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Tab Navigation -->
                <RowDefinition Height="*"/>     <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Modern Title Bar -->
            <Border Grid.Row="0" Height="64" Margin="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="{DynamicResource PrimaryColor}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                        <!-- Modern App Title and Icon -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                            <Ellipse Width="32" Height="32" Fill="White" Margin="0,0,16,0"
                                     RenderOptions.EdgeMode="Unspecified"
                                     UseLayoutRounding="True"
                                     SnapsToDevicePixels="True"
                                     RenderOptions.BitmapScalingMode="HighQuality">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SPT Launcher" Foreground="White" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Name="VersionText" Text="v3.0.0" Foreground="#E0E7FF" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                
                <!-- Modern Window Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button Name="MinimizeButton" Width="44" Height="32" Background="Transparent" BorderThickness="0" 
                            Click="MinimizeButton_Click" Cursor="Hand" Margin="2">
                        <TextBlock Text="−" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Name="MaximizeButton" Width="44" Height="32" Background="Transparent" BorderThickness="0" 
                            Click="MaximizeButton_Click" Cursor="Hand" Margin="2">
                        <TextBlock Text="□" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Name="CloseButton" Width="44" Height="32" Background="#EF4444" BorderThickness="0" 
                            Click="CloseButton_Click" Cursor="Hand" Margin="2">
                        <TextBlock Text="×" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Modern Tab Navigation -->
        <Border Grid.Row="1" Background="{DynamicResource PrimaryColor}" BorderThickness="0" Padding="16,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="0,0">
                    <Button Name="LauncherTabButton" Content="Launcher" Tag="launcher" 
                            Click="TabButton_Click" Height="48" Padding="24,12" Margin="0,0,0,0"
                            Style="{StaticResource TabButtonStyle}" Background="{DynamicResource PrimaryColor}" FontWeight="SemiBold"/>
                    <Rectangle Width="1" Height="32" Fill="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Name="ServersTabButton" Content="Servers" Tag="servers" 
                            Click="TabButton_Click" Height="48" Padding="24,12" Margin="0,0,0,0"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Rectangle Width="1" Height="32" Fill="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Name="ModsTabButton" Content="Mods" Tag="mods" 
                            Click="TabButton_Click" Height="48" Padding="24,12" Margin="0,0,0,0"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Rectangle Width="1" Height="32" Fill="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Name="SettingsTabButton" Content="Settings" Tag="settings" 
                            Click="TabButton_Click" Height="48" Padding="24,12" Margin="0,0,0,0"
                            Style="{StaticResource TabButtonStyle}"/>
                    <Rectangle Width="1" Height="32" Fill="{DynamicResource PrimaryColor}" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Name="DevToolsTabButton" Content="Tools" Tag="devtools" 
                            Click="TabButton_Click" Height="48" Padding="24,12" Margin="0,0,0,0"
                            Style="{StaticResource TabButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

            <!-- Modern Content Area -->
            <Grid Grid.Row="2" Background="{DynamicResource BackgroundColor}" Margin="0">
                <Frame Name="ContentFrame" NavigationUIVisibility="Hidden" Background="{DynamicResource BackgroundColor}" Margin="24"/>
            </Grid>
        </Grid>
    </Border>
</Window>
