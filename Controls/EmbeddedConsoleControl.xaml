<UserControl x:Class="SptLauncherWpf.Controls.EmbeddedConsoleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="300" Width="600">
    <Grid Background="#111">
        <!-- Console output -->
        <ScrollViewer x:Name="OutputScrollViewer"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Hidden"
                      Margin="5"
                      ScrollChanged="OutputScrollViewer_ScrollChanged">
            <TextBox x:Name="OutputBlock"
                     FontFamily="Consolas"
                     FontSize="13"
                     Foreground="#0f0"
                     Background="#111"
                     BorderThickness="0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Text=""
                     SelectionChanged="OutputBlock_SelectionChanged"/>
        </ScrollViewer>
    </Grid>
</UserControl>
