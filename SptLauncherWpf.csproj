<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- Standard Windows target (no SDK needed - saves ~24MB) -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Application Icon -->
    <ApplicationIcon>spt_rpg_icon.ico</ApplicationIcon>

    <!-- Assembly metadata -->
    <AssemblyName>SPTLauncher</AssemblyName>
    <AssemblyTitle>SPT Launcher</AssemblyTitle>
    <AssemblyDescription>SPT-AKI Launcher with Fika Co-op Support - Modern WPF Version</AssemblyDescription>
    <AssemblyVersion>4.2.5.0</AssemblyVersion>
    <FileVersion>4.2.5.0</FileVersion>
    <Product>SPT Launcher</Product>
    <Company>SPT Launcher Team</Company>
    <Copyright>Copyright © 2025 SPT Launcher Team</Copyright>
  </PropertyGroup>

  <!-- Single-file & self-contained settings -->
  <PropertyGroup>
    <!-- Self-contained single-file (includes .NET runtime - no external dependencies) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>

    <!-- WPF apps must not be trimmed -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Embed native DLLs properly for single-file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- Include all content files in the single executable -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    
    <!-- Enable compression for self-contained single-file (reduces size) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Don't include PDB files in publish (optional - remove if you want debug symbols) -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="spt_rpg_icon.ico" />
    <!-- Icon is embedded in the executable, no need to copy separately -->
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SptLauncherWpf.Tests/**" />
    <EmbeddedResource Remove="SptLauncherWpf.Tests/**" />
    <None Remove="SptLauncherWpf.Tests/**" />
    <Page Remove="SptLauncherWpf.Tests/**" />
  </ItemGroup>
  
  <!-- Remove JSON files after publish (not needed for self-contained single-file) -->
  <Target Name="RemoveJsonFilesAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <JsonFilesToDelete Include="$(PublishDir)$(AssemblyName).deps.json" />
      <JsonFilesToDelete Include="$(PublishDir)$(AssemblyName).runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(JsonFilesToDelete)" ContinueOnError="true" />
  </Target>

</Project>
