<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!-- Standard Windows target (no SDK needed - saves ~24MB) -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Application Icon -->
    <ApplicationIcon>spt_rpg_icon.ico</ApplicationIcon>

    <!-- Assembly metadata -->
    <AssemblyName>SPTLauncher</AssemblyName>
    <AssemblyTitle>SPT Launcher</AssemblyTitle>
    <AssemblyDescription>SPT-AKI Launcher with Fika Co-op Support - Modern WPF Version</AssemblyDescription>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Product>SPT Launcher</Product>
    <Company>SPT Launcher Team</Company>
    <Copyright>Copyright © 2025 SPT Launcher Team</Copyright>
  </PropertyGroup>

  <!-- Single-file & self-contained settings -->
  <PropertyGroup>
    <!-- Default to false; can be overridden at publish time -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>

    <!-- WPF apps must not be trimmed -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Embed native DLLs properly for single-file -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Compress the single-file bundle -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="spt_rpg_icon.ico" />
    <None Include="spt_rpg_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
